# Copier en .env (jamais commite, voir .gitignore) pour tester la fonction
# d'alerte en local avec scripts/test-surf-alert.js. En production, ces
# memes variables se configurent dans Netlify (Site settings > Environment
# variables), jamais en dur dans le code.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Genere une seule fois (ex: openssl rand -hex 24), utilise pour verifier
# que les requetes recues par netlify/functions/telegram-webhook.js
# viennent bien de Telegram (header X-Telegram-Bot-Api-Secret-Token). A
# fournir aussi a l'appel setWebhook, voir scripts/setup-telegram-webhook.js.
TELEGRAM_WEBHOOK_SECRET=

# Optionnel : lien vers le dashboard inclus dans le message d'alerte. En
# production, Netlify injecte automatiquement process.env.URL, cette
# variable ne sert qu'en local ou pour la surcharger.
DASHBOARD_URL=
